# NOTE: Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app, and
# reads them when Metro starts (restart Metro after changing this file).

# Base URL of the Himig karaoke server (server/app.py), no trailing slash.
# Emulator with `adb reverse tcp:8000 tcp:8000`:  http://localhost:8000
# Phone on the same Wi-Fi:                        http://<your-PC-LAN-IP>:8000
EXPO_PUBLIC_KARAOKE_URL=
