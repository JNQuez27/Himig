<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS everywhere, except our API host, which has no HTTPS (Freehostia free plan).
     Remove the domain-config once the host serves HTTPS. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">jquezada.duckdns.org</domain>
  </domain-config>
</network-security-config>
