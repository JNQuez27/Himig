# Spotify Web API credentials.
# Create a free app at https://developer.spotify.com/dashboard to get these.
# Kept server-side only — never shipped to the mobile app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional extra key, only if your deployment uses one.
SPOTIFY_API_KEY=

# MySQL connection. Leave blank to use the local XAMPP defaults
# (host=localhost, db=himig, user=root, empty password).
# Set real values on a production host.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
