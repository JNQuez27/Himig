RewriteEngine On

# Himig. QSA keeps extra query params (?user=, ?name=, ?genre=) on the short URLs.
RewriteRule ^artists/?$ artists.php [NC,L,QSA]
RewriteRule ^artists/([0-9]+)/?$ artists.php?id=$1 [NC,L,QSA]
RewriteRule ^songs/(home|trending)/?$ spotify.php?feed=$1 [NC,L,QSA]

SetEnvIf Authorization .+ HTTP_AUTHORIZATION=$0

# Block web access to the secrets files and dev-only scripts (they sit inside the
# public folder). Works on both Apache 2.4 (Require) and older 2.2 (Order/Deny).
#   .env / .env.*        -> credentials
#   build_snapshot.php   -> uses your Spotify keys; run it locally only
#   nettest.php          -> connectivity diagnostic; delete after use
<FilesMatch "^(\.env.*|build_snapshot\.php|nettest\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
